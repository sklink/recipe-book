# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase (T2, T3) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (T3) ---
# Comma-separated list of email addresses permitted to sign in. RLS grants every
# authenticated session full access to the shared cookbook, so this allowlist is
# what makes that safe — every address here gets full read/write on everything.
#   AUTH_ALLOWED_EMAIL=you@example.com,partner@example.com
AUTH_ALLOWED_EMAIL=

# --- Anthropic: recipe + variant generation (T18) ---
ANTHROPIC_API_KEY=

# --- OpenAI: recipe image generation (T21) ---
OPENAI_API_KEY=
