# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase (T2, T3) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (T3) ---
# The single email address permitted to sign in. RLS grants every authenticated
# session full access, so this allowlist is what makes that safe.
AUTH_ALLOWED_EMAIL=

# --- Anthropic: recipe + variant generation (T18) ---
ANTHROPIC_API_KEY=

# --- OpenAI: recipe image generation (T21) ---
OPENAI_API_KEY=
